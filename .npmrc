# Der @zeit-Scope wird FIRMENINTERN über GitHub Packages bezogen, nicht über die
# öffentliche npm-Registry. Alles andere (svelte, vite, …) kommt weiterhin von npmjs.
@zeit:registry=https://npm.pkg.github.com

# Auth kommt aus der Umgebung, NIE aus dieser Datei — sie ist committet.
# Konsumierende Projekte setzen vor `npm install`:
#   export NODE_AUTH_TOKEN=<GitHub PAT mit read:packages>
# In GitHub Actions liefert `actions/setup-node` mit `registry-url` das automatisch
# aus dem GITHUB_TOKEN.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
