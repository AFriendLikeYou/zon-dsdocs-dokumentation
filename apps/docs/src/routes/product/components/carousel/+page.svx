>\n\t</div>\n\t<div class=\"z-carousel__tabpanel-control-wrapper\" role=\"group\" aria-label=\"Seitensteuerung\" hidden>\n\t\t<fieldset class=\"z-carousel__dots-wrapper\" role=\"tablist\" aria-label=\"Anzuzeigende Seite auswählen\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 1\" checked>\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 2\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 3\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 4\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 5\">\n\t\t</fieldset>\n\t</div>\n</z-carousel>","note":"Pfeile liegen in den Rand-Zonen über der Spur."},{"label":"Autoplay","html":"<z-carousel class=\"z-carousel z-carousel--autoplay\" role=\"group\" aria-roledescription=\"Karussell\" aria-label=\"Beispiel-Karussell\">\n\t<div class=\"z-carousel__scroll-container\" tabindex=\"-1\" aria-live=\"polite\" aria-atomic=\"false\">\n\t\t<div class=\"z-carousel__slide\">Slot 1</div>\n\t\t<div class=\"z-carousel__slide\">Slot 2</div>\n\t\t<div class=\"z-carousel__slide\">Slot 3</div>\n\t\t<div class=\"z-carousel__slide\">Slot 4</div>\n\t\t<div class=\"z-carousel__slide\">Slot 5</div>\n\t</div>\n\t<div class=\"z-carousel__slide-control-wrapper\" role=\"group\" aria-label=\"Steuerelemente\" hidden>\n\t\t<button class=\"z-carousel__direction-button z-carousel__direction-button--previous\" aria-label=\"Vorige Seite\" disabled><svg class=\"z-carousel__direction-icon\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M7 1 1 7l6 6M1 7h12\"></path></svg></button>\n\t\t<button class=\"z-carousel__direction-button z-carousel__direction-button--next\" aria-label=\"Nächste Seite\"><svg class=\"z-carousel__direction-icon\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m7 1 6 6-6 6m6-6H1\"></path></svg></button>\n\t</div>\n\t<div class=\"z-carousel__tabpanel-control-wrapper\" role=\"group\" aria-label=\"Seitensteuerung\" hidden>\n\t\t<fieldset class=\"z-carousel__dots-wrapper\" role=\"tablist\" aria-label=\"Anzuzeigende Seite auswählen\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 1\" checked>\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 2\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 3\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 4\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 5\">\n\t\t</fieldset>\n\t</div>\n</z-carousel>","note":"Zustandsbild des automatischen Wechsels: der aktive Punkt wird zur Kapsel. Die Auslieferung animiert darin einen Fortschritt und stellt einen Play/Pause-Knopf daneben; <z-carousel> bringt den Wechsel bewusst nicht mit."},{"label":"Ohne Steuerung","html":"<z-carousel class=\"z-carousel z-carousel--no-controls\" role=\"group\" aria-roledescription=\"Karussell\" aria-label=\"Beispiel-Karussell\">\n\t<div class=\"z-carousel__scroll-container\" tabindex=\"-1\" aria-live=\"polite\" aria-atomic=\"false\">\n\t\t<div class=\"z-carousel__slide\">Slot 1</div>\n\t\t<div class=\"z-carousel__slide\">Slot 2</div>\n\t\t<div class=\"z-carousel__slide\">Slot 3</div>\n\t\t<div class=\"z-carousel__slide\">Slot 4</div>\n\t\t<div class=\"z-carousel__slide\">Slot 5</div>\n\t</div>\n\t<div class=\"z-carousel__slide-control-wrapper\" role=\"group\" aria-label=\"Steuerelemente\" hidden>\n\t\t<button class=\"z-carousel__direction-button z-carousel__direction-button--previous\" aria-label=\"Vorige Seite\" disabled><svg class=\"z-carousel__direction-icon\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M7 1 1 7l6 6M1 7h12\"></path></svg></button>\n\t\t<button class=\"z-carousel__direction-button z-carousel__direction-button--next\" aria-label=\"Nächste Seite\"><svg class=\"z-carousel__direction-icon\" viewBox=\"0 0 14 14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m7 1 6 6-6 6m6-6H1\"></path></svg></button>\n\t</div>\n\t<div class=\"z-carousel__tabpanel-control-wrapper\" role=\"group\" aria-label=\"Seitensteuerung\" hidden>\n\t\t<fieldset class=\"z-carousel__dots-wrapper\" role=\"tablist\" aria-label=\"Anzuzeigende Seite auswählen\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 1\" checked>\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 2\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 3\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 4\">\n\t\t\t<input class=\"z-carousel__dot\" type=\"radio\" role=\"tab\" aria-label=\"Seite 5\">\n\t\t</fieldset>\n\t</div>\n</z-carousel>","note":"Reine Scroll-Leiste ohne Pfeile und Punkte (Figma-Prop Controls = false)."}];
	const offeneVariantItems = variantItems.filter((it) => !abgedeckteVarianten.has(it.label));
	const propsData = [{"name":"z-carousel--single","typ":"Modifier-Klasse","default":"—","beschreibung":"Eine Seite je Ansicht, ohne Gap und ohne Seitenrand (Auslieferung: view-mode=\"single\")."},{"name":"z-carousel--continuous","typ":"Modifier-Klasse","default":"—","beschreibung":"Hebt das Einrasten auf — die Leiste läuft frei weiter (Auslieferung: view-mode=\"continuous\")."},{"name":"z-carousel--kiosk / --shop","typ":"Modifier-Klasse","default":"—","beschreibung":"Feste Slot-Breite 12.25rem bzw. 20rem; Shop tönt zusätzlich den Fader (Auslieferung: variant=\"kiosk\"/\"shop\")."},{"name":"z-carousel--overlay-controls","typ":"Modifier-Klasse","default":"—","beschreibung":"Die Pfeile liegen in den Rand-Zonen über der Spur statt darunter."},{"name":"z-carousel--autoplay","typ":"Modifier-Klasse","default":"—","beschreibung":"Zeigt den Fortschritts-Zustand des automatischen Wechsels (breite Kapsel). Der Wechsel selbst ist nicht Teil von <z-carousel>."},{"name":"z-carousel--no-controls","typ":"Modifier-Klasse","default":"—","beschreibung":"Blendet beide Steuerungszeilen aus — reine Scroll-Leiste (Figma-Prop Controls = false)."},{"name":"hidden (auf den Steuerungszeilen)","typ":"Attribut","default":"gesetzt","beschreibung":"Im Markup gesetzt, vom Element entfernt, sobald es etwas zu blättern gibt. So stehen ohne JavaScript keine toten Knöpfe da."},{"name":"seite","typ":"number (Property, nur lesen)","default":"0","beschreibung":"Index der Seite, die gerade an der Inhaltskante steht — aus der Scroll-Position abgeleitet, nicht gemerkt."},{"name":"zeigeSeite(index)","typ":"Methode","default":"—","beschreibung":"Blättert zu einer Seite; der Index wird geklemmt. weiter() und zurueck() sind die Kurzformen."}];
</script>

<svelte:head>
	<title>{title} - Die Zeit Design System</title>
</svelte:head>

# {title}

<ComponentHero spec={spec} version={content.version} />

<Tabs tabs={[
		{ id: 'designTab', label: 'Design', component: designTab },
		{ id: 'developTab', label: 'Develop', component: developTab },
		...((spec.a11y?.length || spec.tastatur?.length) ? [{ id: 'a11yTab', label: 'Barrierefreiheit', component: a11yTab }] : []),
		{ id: 'specsTab', label: 'Specs', component: specsTab }
]} sticky />

{#snippet designTab()}
	<h2 id="playground" class="section-anchor">Playground</h2>
	<Playground controls={playgroundControls} template={playgroundTemplate} align={buehne} resizable={spec.playground?.resizable} />

	{#if beispiele.length}
		<h2 id="beispiele" class="section-anchor">Beispiele</h2>
		{#each beispiele as beispiel, i (i)}
			<ExampleBlock
				titel={beispiel.titel}
				beschreibung={beispiel.beschreibung}
				fill={buehne === 'fill'}
				instanzen={(beispiel.instanzen ?? [{}]).map((werte) =>
					instantiate(playgroundTemplate, playgroundControls, werte)
				)}
			/>
		{/each}
	{/if}

	<h2 id="anatomie" class="section-anchor">Anatomie</h2>
	<Anatomy masse={spec.masse} spacing={spec.spacing} callouts={spec.callouts} align={buehne} {calloutAnchors}>
		{#snippet preview()}<div class="z-carousel" style="--_z-carousel-slide-width: calc(320 / 892 * 100%)"><div class="z-carousel__scroll-container"><div class="z-carousel__slide">Slot 1</div><div class="z-carousel__slide">Slot 2</div><div class="z-carousel__slide">Slot 3</div></div><div class="z-carousel__tabpanel-control-wrapper"><fieldset class="z-carousel__dots-wrapper"><input class="z-carousel__dot" type="radio" name="pv-carousel" aria-label="Seite 1" checked><input class="z-carousel__dot" type="radio" name="pv-carousel" aria-label="Seite 2"><input class="z-carousel__dot" type="radio" name="pv-carousel" aria-label="Seite 3"></fieldset></div></div>{/snippet}
	</Anatomy>

	{#if spec.verwendung?.nutzen?.length || spec.verwendung?.nichtNutzen?.length}
		<h2 id="verwendung" class="section-anchor">Verwendung</h2>
		<UsageBlock verwendung={spec.verwendung} />
	{/if}

	{#if spec.wording?.length}
		<h2 id="wording" class="section-anchor">Texte &amp; Wording</h2>
		<WordingList items={spec.wording} />
	{/if}

	{#if offeneVariantItems.length}
		<h2 id="varianten" class="section-anchor">
			{abgedeckteVarianten.size ? 'Weitere Varianten' : 'Varianten'}
		</h2>
		<SpecimenGrid items={offeneVariantItems} />
	{/if}

	<h2 id="zustaende" class="section-anchor">Zustände</h2>
	<StateList states={[{"label":"default","vorhanden":true},{"label":"hover (Pfeile/Punkte)"},{"label":"focus-visible"},{"label":"disabled (Pfeil am Ende)"},{"label":"checked (aktiver Punkt)"}]} hint="Statisch nicht darstellbar (reine Pseudoklassen) — im Playground per Interaktion sichtbar." />

	{#if spec.doDont?.do?.length || spec.doDont?.dont?.length}
		<h2 id="do-dont" class="section-anchor">Do & Don't</h2>
		<DoDontList doDont={spec.doDont} />
	{/if}

	{#if spec.verwandt?.length}
		<h2 id="verwandte" class="section-anchor">Verwandte Komponenten</h2>
		<RelatedComponents slugs={spec.verwandt} />
	{/if}

	{#if spec.faq?.length}
		<h2 id="faq" class="section-anchor">FAQ</h2>
		<FaqList items={spec.faq} />
	{/if}
{/snippet}

{#snippet developTab()}
	<h2>Komponente holen</h2>
	<GetComponent artefakte={spec.code?.artefakte} />

	<h2>Properties</h2>
	<PropsTable props={propsData} />

	<h2>Code</h2>
	<CodeBlock title="HTML" lang="html" code={htmlCode} />
	<CodeBlock title="CSS · Pattern (carousel.css)" lang="css" code={patternCssCode} />

	{#if (editorial.codeBeispiele ?? []).length}
		<h2>Redaktionelle Code-Beispiele</h2>
		{#each editorial.codeBeispiele ?? [] as beispiel, i (i)}
			<h3>{beispiel.label}</h3>
			{#if beispiel.hinweis}<p>{beispiel.hinweis}</p>{/if}
			<CodeBlock lang={beispiel.sprache ?? 'svelte'} code={beispiel.code} />
		{/each}
	{/if}
{/snippet}

{#snippet a11yTab()}
	{#if spec.a11y?.length}
		<A11yList items={spec.a11y} />
	{/if}

	{#if spec.tastatur?.length}
		<h2>Tastatur</h2>
		<KeyboardList items={spec.tastatur} />
	{/if}
{/snippet}

{#snippet specsTab()}
	<h2>Maße</h2>
	<MeasureTable masse={spec.masse} overrides={spec.overrides} />

	<h2>Farbrollen</h2>
	<ColorRoleTable farbrollen={spec.farbrollen} />

	<h2>Tokens</h2>
	<TokenTable tokens={spec.tokens} />
{/snippet}

<style>
:global(.spec-canvas z-carousel),
:global(.pg-preview z-carousel) {
  display: block;
}
:global(.spec-canvas .z-carousel),
:global(.pg-preview .z-carousel) {
  --_z-carousel-padding-inline: var(--z-ds-space-m);
	--_z-carousel-button-bg: var(--z-ds-color-background-10);
	--_z-carousel-button-bg-hover: var(--z-ds-color-background-20);
	--_z-carousel-button-fg: var(--z-ds-color-text-70);
	--_z-carousel-button-gradient-color: var(--z-ds-color-background-0);
	--_z-carousel-button-size: 1.875rem; 
	--_z-carousel-icon-size: 0.875rem; 
	--_z-carousel-slide-gap: var(--z-ds-space-m);
	--_z-carousel-slide-width: calc(320 / 343 * 100%);
	display: grid;
	grid-template-areas: 'left middle right';
	grid-template-columns: var(--_z-carousel-padding-inline) 1fr var(--_z-carousel-padding-inline);
	row-gap: var(--z-ds-space-m);
	
	width: 100%;
	
	margin-bottom: var(--z-ds-space-l);
}
@container (min-width: 48em) {
  :global(.spec-canvas .z-carousel),
  :global(.pg-preview .z-carousel) {
    --_z-carousel-padding-inline: var(--z-ds-space-xl);
  		--_z-carousel-slide-width: calc(320 / 892 * 100%);
  }
  :global(.spec-canvas .z-carousel:not(.z-carousel--single)::before),
  :global(.pg-preview .z-carousel:not(.z-carousel--single)::before),
  :global(.spec-canvas .z-carousel:not(.z-carousel--single)::after),
  :global(.pg-preview .z-carousel:not(.z-carousel--single)::after) {
    content: '';
  		pointer-events: none;
  		z-index: 9;
  }
  :global(.spec-canvas .z-carousel:not(:has(.z-carousel__direction-button--previous:disabled))::before),
  :global(.pg-preview .z-carousel:not(:has(.z-carousel__direction-button--previous:disabled))::before),
  :global(.spec-canvas .z-carousel:not(:has(.z-carousel__direction-button--next:disabled))::after),
  :global(.pg-preview .z-carousel:not(:has(.z-carousel__direction-button--next:disabled))::after) {
    background: linear-gradient(
  			270deg,
  			rgba(255, 255, 255, 0) 0%,
  			var(--_z-carousel-button-gradient-color) 100%
  		);
  }
  :global(.spec-canvas .z-carousel::before),
  :global(.pg-preview .z-carousel::before) {
    grid-area: 1 / left;
  }
  :global(.spec-canvas .z-carousel::after),
  :global(.pg-preview .z-carousel::after) {
    grid-area: 1 / right;
  		transform: rotate(180deg);
  }
}
@container (min-width: 61.25em) {
  :global(.spec-canvas .z-carousel),
  :global(.pg-preview .z-carousel) {
    --_z-carousel-padding-inline: clamp(
  			var(--z-ds-space-m),
  			calc(50% - 55.75rem / 2),
  			3.375rem
  		);
  }
}
:global(.spec-canvas .z-carousel__scroll-container),
:global(.pg-preview .z-carousel__scroll-container) {
  display: flex;
	gap: var(--_z-carousel-slide-gap);
	grid-area: 1 / 1 / 2 / -1;
	overflow: auto hidden;
	padding-inline: var(--_z-carousel-padding-inline);
	position: relative;
	scroll-padding-left: var(--_z-carousel-padding-inline);
	scroll-snap-type: x mandatory;
}
@media screen and (prefers-reduced-motion: no-preference) {
  :global(.spec-canvas .z-carousel__scroll-container),
  :global(.pg-preview .z-carousel__scroll-container) {
    scroll-behavior: smooth;
  }
}
:global(.spec-canvas .z-carousel__scroll-container:focus-visible),
:global(.pg-preview .z-carousel__scroll-container:focus-visible) {
  outline: 2px solid var(--z-ds-color-focus-100);
	outline-offset: -2px;
}
:global(.spec-canvas .z-carousel__scroll-container > *),
:global(.pg-preview .z-carousel__scroll-container > *) {
  flex: 0 0 var(--_z-carousel-slide-width);
	scroll-snap-align: start;
}
:global(.spec-canvas .z-carousel__slide),
:global(.pg-preview .z-carousel__slide) {
  aspect-ratio: 1 / 1;
	max-height: 20rem;
	border-radius: var(--z-ds-border-radius-4);
	background-color: var(--z-ds-color-background-10);
	box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--z-ds-color-text-100) 8%, transparent);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: var(--z-ds-fontsize-16);
	color: var(--z-ds-color-text-55);
}
:global(.spec-canvas .z-carousel__slide-control-wrapper),
:global(.pg-preview .z-carousel__slide-control-wrapper) {
  grid-area: 2 / middle;
	justify-self: end;
}
:global(.spec-canvas .z-carousel__direction-button),
:global(.pg-preview .z-carousel__direction-button) {
  background: var(--_z-carousel-button-bg);
	border: none;
	border-radius: 50%;
	color: var(--_z-carousel-button-fg);
	cursor: pointer;
	height: var(--_z-carousel-button-size);
	width: var(--_z-carousel-button-size);
}
:global(.spec-canvas .z-carousel__direction-button:hover),
:global(.pg-preview .z-carousel__direction-button:hover),
:global(.spec-canvas .z-carousel__direction-button:active),
:global(.pg-preview .z-carousel__direction-button:active),
:global(.spec-canvas .z-carousel__direction-button:focus-visible),
:global(.pg-preview .z-carousel__direction-button:focus-visible) {
  background: var(--_z-carousel-button-bg-hover);
}
:global(.spec-canvas .z-carousel__direction-button:not(:disabled)),
:global(.pg-preview .z-carousel__direction-button:not(:disabled)) {
  pointer-events: all;
}
:global(.spec-canvas .z-carousel__direction-button:disabled),
:global(.pg-preview .z-carousel__direction-button:disabled) {
  background: var(--_z-carousel-button-bg);
	cursor: default;
}
:global(.spec-canvas .z-carousel__direction-button:disabled svg),
:global(.pg-preview .z-carousel__direction-button:disabled svg) {
  opacity: 0.6;
}
:global(.spec-canvas .z-carousel__direction-button:focus-visible),
:global(.pg-preview .z-carousel__direction-button:focus-visible) {
  outline: 2px solid var(--z-ds-color-focus-100);
	outline-offset: 2px;
}
:global(.spec-canvas .z-carousel__direction-button--previous),
:global(.pg-preview .z-carousel__direction-button--previous) {
  margin-right: var(--z-ds-space-s);
}
:global(.spec-canvas .z-carousel__direction-icon),
:global(.pg-preview .z-carousel__direction-icon) {
  display: block;
	height: var(--_z-carousel-icon-size);
	margin: auto;
	width: var(--_z-carousel-icon-size);
}
:global(.spec-canvas .z-carousel__tabpanel-control-wrapper:not([hidden])),
:global(.pg-preview .z-carousel__tabpanel-control-wrapper:not([hidden])) {
  align-items: center;
	display: flex;
	grid-area: 2 / middle;
	max-width: min-content;
}
:global(.spec-canvas .z-carousel:has(.z-carousel__tabpanel-control-wrapper) .z-carousel__scroll-container),
:global(.pg-preview .z-carousel:has(.z-carousel__tabpanel-control-wrapper) .z-carousel__scroll-container) {
  overflow-x: scroll;
	-webkit-overflow-scrolling: touch;
	-ms-overflow-style: none;
	scrollbar-width: none;
}
:global(.spec-canvas .z-carousel:has(.z-carousel__tabpanel-control-wrapper) .z-carousel__scroll-container::-webkit-scrollbar),
:global(.pg-preview .z-carousel:has(.z-carousel__tabpanel-control-wrapper) .z-carousel__scroll-container::-webkit-scrollbar) {
  display: none;
}
:global(.spec-canvas .z-carousel__dots-wrapper),
:global(.pg-preview .z-carousel__dots-wrapper) {
  border: none;
	display: flex;
	margin: 0;
	max-width: 7rem;
	min-width: 0;
	overflow: hidden;
	padding: 0;
	scroll-snap-type: x mandatory;
}
:global(.spec-canvas .z-carousel__dot),
:global(.pg-preview .z-carousel__dot) {
  -webkit-appearance: none;
	appearance: none;
	background-clip: content-box;
	background-color: var(--z-ds-color-background-20);
	border: 0.25rem solid transparent;
	border-radius: 0.5rem;
	cursor: pointer;
	flex: 0 0 auto;
	height: 1rem;
	scroll-snap-align: start;
	transition:
		background-color 0.2s,
		border-width 0.2s linear,
		width 0.2s linear;
