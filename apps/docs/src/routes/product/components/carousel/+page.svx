	const patternCssCode = `/* z-carousel — Karussell. Originalgetreu portiert aus dem ausgelieferten Bundle
   static.zeit.de/p/zeit.web/css/web.core/standalone/zon-carousel.56f111d6….css
   (9.108 Bytes, vollständig gelesen 2026-07-26) und live nachgemessen an
   zeit.de/index bei 375, 800 und 1280 px Viewport. Echte --z-ds-Tokens.

   NAMEN. Produktion adressiert das Custom Element direkt (\`zon-carousel\`) und
   benennt die Teile \`zon-carousel__*\`. Hier steht \`.z-carousel\` als KLASSE auf
   der Wurzel — genau wie in der Produktion, wo das Element zusätzlich
   \`class="zon-carousel"\` trägt. Der Grund ist die Adoptionsstrategie: Mit einer
   Klasse funktioniert das Pattern auch als reines \`<div class="z-carousel">\`,
   ganz ohne Custom Element. \`<z-carousel class="z-carousel">\` ist dieselbe
   Darstellung plus Verhalten.

   WAS SICH GEGENÜBER DER VORIGEN FASSUNG GEÄNDERT HAT — und warum:

   1) DIE GRÖSSEN-ACHSE „Small/Wide" IST EIN BREAKPOINT, KEIN MODIFIER.
      Die alte Fassung führte 54 px Inline-Rand in der Basis UND eine Klasse
      \`--wide\`, die denselben Wert nochmal setzte: ein No-op. Belegt ist etwas
      anderes — der Rand hat drei Stufen, alle nachgemessen:
        · < 48em      16 px  (Produktion: \`var(--z-gap)\` = 1rem)
        · ≥ 48em      32 px  (\`var(--z-gap)\` = 2rem)
        · ≥ 61.25em   bis 54 px (clamp, siehe unten)
      Figmas Varianten „Size=Small" (375 breit, Rand 16, Track 343) und
      „Size=Wide" (1000 breit, Rand 54, Track 892) sind exakt die Enden dieser
      Kette: bei Viewport 375 misst die echte Instanz \`16px 343px 16px\`, bei
      1280 misst sie \`54px 892px 54px\` — beides live abgelesen. Figma modelliert
      also zwei Bildschirmbreiten, nicht zwei Varianten. Deshalb steht das jetzt
      als \`@media\` hier (mobile-first, wie die Produktion) und nicht als Klasse.
      Dasselbe Muster wie beim \`hero\` (siehe dessen \`hero.css\`).

   2) DIE ACHSE „Slot Size" (Large/Middle/Small) HAT KEINE CODE-ENTSPRECHUNG.
      Figma zeichnet Slots zu 320², 236² und 184². Im ausgelieferten CSS kommen
      236 und 184 NICHT vor — die einzigen Slot-Breiten sind
      \`calc(320/343·100%)\`, \`calc(320/892·100%)\`, \`33%\` (bei genau 3 Slots),
      \`12.25rem\` (kiosk), \`20rem\` (shop) und \`100%\` (single). Die alte Fassung
      erfand dafür \`--middle\`/\`--slot-small\` als \`max-width\`. Das ist ersatzlos
      entfallen; die Divergenz steht als solche in der model.json.

   3) BEM-NAMEN GERADEGEZOGEN. Die alte Fassung schrieb
      \`__direction-button-previous\` (ein Bindestrich), das Template dagegen
      \`--previous\` — die Regel griff nie. Jetzt beide Seiten wie im Original.

   4) DIE AUTOPLAY-WEICHE \`--stopped\` IST ENTFALLEN. Sie schaltete im Original
      zwischen Play- und Pause-Ikone um. Da \`<z-carousel>\` kein Autoplay
      mitbringt (Begründung im Kopf von carousel.ts), setzte diese Klasse hier
      niemand — eine Regel auf einen Zustand, den es nicht gibt, ist genau die
      Sorte No-op, die diese Datei gerade losgeworden ist. Der Play/Pause-Knopf
      behält sein Aussehen, seine Ikone steht sichtbar im Markup.

   BEWUSSTE ABWEICHUNGEN vom Original — jede einzeln begründet:

   a) \`mix-blend-mode\` auf Pfeilen und Punkten fällt weg. Das Original speist es
      aus einer ZON-Seitenvariablen (Wert: multiply hell, screen dunkel), die
      KEIN ZDS-Token ist — sie steht nicht in packages/tokens/vendor/styles-zds.css.
      Außerhalb von zeit.de wäre die Variable leer und die Deklaration ungültig;
      hier stünde also nur der Name eines Tokens, das es nicht gibt.
   b) Die Autoplay-Fortschrittsanimation (\`@keyframes fill-dot\` + \`::after\`)
      fehlt: Der Exporter lehnt \`@keyframes\` im Pattern-CSS bewusst ab (der Name
      wäre global). Der aktive Dot zeigt hier den Endzustand, nicht den Lauf.
   c) \`.z-carousel__slide\` bekommt eine sichtbare Platzhalterfläche, quadratisch
      und bei 20rem gedeckelt. Im Original ist der Slot ein reiner Wrapper ohne
      eigenes Aussehen — die Doku braucht etwas zu zeigen. Quadratisch ist
      belegt (Figma: 320², 236², 184²), die Deckelung ist Figmas größter Slot.
   d) Der Scroll-Container bekommt einen Fokus-Ring. Das Element macht ihn
      tastaturerreichbar (Produktion setzt \`tabindex="-1"\`, siehe carousel.ts);
      wer ihn fokussieren kann, muss das auch sehen. Die Outline ist dieselbe,
      die dasselbe Bundle für Pfeile und Dots schon führt.

   Das Verhalten (Blättern, Fortschritt, Tastatur) steht NICHT hier, sondern in
   carousel.ts. Ohne JavaScript bleibt die Leiste eine scrollbare Liste mit
   Scroll-Snap — das kann CSS allein, und genau das ist der Grundzustand. */

/* Ohne Klasse bleibt ein unbekanntes Element inline — die eine Zeile verhindert,
   dass ein vergessenes \`class="z-carousel"\` den Aufbau in den Textfluss kippt.
   \`.z-carousel\` unten gewinnt über die höhere Spezifität. */
z-carousel {
	display: block;
}

/* Wurzel-Grid: left | middle | right. Die beiden Rand-Spalten sind zugleich die
   Zonen für Fader und Overlay-Pfeile — deshalb Spalten und nicht \`padding\`. */
.z-carousel {
	--_z-carousel-padding-inline: var(--z-ds-space-m);
	--_z-carousel-button-bg: var(--z-ds-color-background-10);
	--_z-carousel-button-bg-hover: var(--z-ds-color-background-20);
	--_z-carousel-button-fg: var(--z-ds-color-text-70);
	--_z-carousel-button-gradient-color: var(--z-ds-color-background-0);
	--_z-carousel-button-size: 1.875rem; /* 30px — gemessen 30×30 */
	--_z-carousel-icon-size: 0.875rem; /* 14px */
	--_z-carousel-slide-gap: var(--z-ds-space-m);
	--_z-carousel-slide-width: calc(320 / 343 * 100%);
	display: grid;
	grid-template-areas: 'left middle right';
	grid-template-columns: var(--_z-carousel-padding-inline) 1fr var(--_z-carousel-padding-inline);
	row-gap: var(--z-ds-space-m);
	/* Im normalen Fluss redundant, in einem Flex- oder Grid-Elternteil aber der
	   Unterschied zwischen „so breit wie die Slots" und „so breit wie die Spalte":
	   Ein Grid mit \`1fr\`-Mittelspalte schrumpft dort sonst auf seine max-content-
	   Breite, und die Rand-Zonen — die ja gerade die Breite abbilden — stimmten
	   nicht mehr. Die Produktion legt das Karussell immer über die volle
	   Inhaltsspalte; das hier ist dieselbe Aussage eine Ebene höher. */
	width: 100%;
	/* Das Original deklariert im 61.25em-Block zusätzlich \`--z-ds-space-xl\`,
	   diese Zeile steht dort aber SPÄTER in der Datei und gewinnt bei gleicher
	   Spezifität. Gemessen sind darum 24 px auf allen Breiten — der xl-Wert ist
	   im ausgelieferten Bundle toter Code. Hier steht, was ankommt. */
	margin-bottom: var(--z-ds-space-l);
}

/* Ab 48em: Der Slot bezieht sich auf die breite Spur (892 statt 343) und die
   Rand-Zonen bekommen ihren Fader. Beides gemessen. */
@media screen and (min-width: 48em) {
	.z-carousel {
		/* Produktion: \`var(--z-gap)\`, das ab 48em von 1rem auf 2rem springt
		   (web.site/base/custom-properties). --z-ds-space-xl ist derselbe Wert
		   als ZDS-Token. */
		--_z-carousel-padding-inline: var(--z-ds-space-xl);
		--_z-carousel-slide-width: calc(320 / 892 * 100%);
	}

	/* Fader an den Kanten: verläuft von der Flächenfarbe nach transparent und
	   macht sichtbar, dass die Leiste weitergeht. In Figma existiert er
	   ausschließlich in den „Wide"-Varianten — dieselbe Aussage wie diese
	   Grenze. \`pointer-events: none\`, damit er nichts abfängt. */
	.z-carousel:not(.z-carousel--single)::before,
	.z-carousel:not(.z-carousel--single)::after {
		content: '';
		pointer-events: none;
		z-index: 9;
	}

	/* Der Verlauf kommt nur, wo es auch weitergeht: Ist der Pfeil dieser Seite
	   disabled, ist das Ende erreicht und der Fader bliebe eine Behauptung. */
	.z-carousel:not(:has(.z-carousel__direction-button--previous:disabled))::before,
	.z-carousel:not(:has(.z-carousel__direction-button--next:disabled))::after {
		background: linear-gradient(
			270deg,
			rgba(255, 255, 255, 0) 0%,
			var(--_z-carousel-button-gradient-color) 100%
		);
	}

	.z-carousel::before {
		grid-area: 1 / left;
	}

	.z-carousel::after {
		grid-area: 1 / right;
		transform: rotate(180deg);
	}
}

/* Ab 61.25em zentriert sich die Spur auf die Inhaltsbreite: Der Rand wächst mit
   der Fläche, bis die mittlere Spalte 55.75rem (892 px) misst — dann steht er
   bei 3.375rem (54 px). Genau dieser Endwert ist Figmas „Wide": bei 1000 px
   Fläche ergibt clamp() exakt 54, die Mitte exakt 892. (55.75rem ist ZONs
   \`--z-ds-content-width\`; kein ZDS-Token, deshalb als Wert.) */
@media screen and (min-width: 61.25em) {
	.z-carousel {
		--_z-carousel-padding-inline: clamp(
			var(--z-ds-space-m),
			calc(50% - 55.75rem / 2),
			3.375rem
		);
	}
}

/* Scroll-Container: horizontale Flex-Leiste mit Scroll-Snap. Das ist der
   Grundzustand ohne JavaScript — eine Liste, die man wischen und (dank
   tabindex, siehe carousel.ts) auch mit der Tastatur bewegen kann. */
.z-carousel__scroll-container {
	display: flex;
	gap: var(--_z-carousel-slide-gap);
	grid-area: 1 / 1 / 2 / -1;
	overflow: auto hidden;
	padding-inline: var(--_z-carousel-padding-inline);
	position: relative;
	scroll-padding-left: var(--_z-carousel-padding-inline);
	scroll-snap-type: x mandatory;
}

/* Weiches Scrollen nur, wenn niemand widerspricht — so steht es im Original,
   und so verlangt es der Bewegungs-Leitfaden. Bei \`reduce\` springt die Leiste
   ohne Zwischenbild. */
@media screen and (prefers-reduced-motion: no-preference) {
	.z-carousel__scroll-container {
		scroll-behavior: smooth;
	}
}

/* Abweichung (d): sichtbarer Fokus, weil das Element den Container
   tastaturerreichbar macht. Offset nach innen — außen läge der Ring unter der
   Kante der Rand-Spalten. */
.z-carousel__scroll-container:focus-visible {
	outline: 2px solid var(--z-ds-color-focus-100);
	outline-offset: -2px;
}

.z-carousel__scroll-container > * {
	flex: 0 0 var(--_z-carousel-slide-width);
	scroll-snap-align: start;
}

/* Abweichung (c): Doku-Platzhalter. Quadratisch ist aus Figma belegt (320², 236²,
   184²), die Fläche selbst ist unsere Zutat — im Produkt steht hier ein Teaser,
   dessen Höhe der Inhalt bestimmt. Die Deckelung bei 20rem ist Figmas größter
   Slot: Ohne sie wüchse der Platzhalter auf einer breiten Bühne mit der Breite
   mit und ein einzelner Slot füllte die ganze Seite. */
.z-carousel__slide {
	aspect-ratio: 1 / 1;
	max-height: 20rem;
	border-radius: var(--z-ds-border-radius-4);
	background-color: var(--z-ds-color-background-10);
	box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--z-ds-color-text-100) 8%, transparent);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: var(--z-ds-fontsize-16);
	color: var(--z-ds-color-text-55);
}

/* Controls-Zeile (Pfeile) rechts unter der Spur. */
.z-carousel__slide-control-wrapper {
	grid-area: 2 / middle;
	justify-self: end;
}

.z-carousel__direction-button {
	background: var(--_z-carousel-button-bg);
	border: none;
	border-radius: 50%;
	color: var(--_z-carousel-button-fg);
	cursor: pointer;
	height: var(--_z-carousel-button-size);
	width: var(--_z-carousel-button-size);
}

.z-carousel__direction-button:hover,
.z-carousel__direction-button:active,
.z-carousel__direction-button:focus-visible {
	background: var(--_z-carousel-button-bg-hover);
}

.z-carousel__direction-button:not(:disabled) {
	pointer-events: all;
}

/* Am Ende bleibt der Pfeil STEHEN und wird nur gedimmt — ein verschwundener
   Pfeil ist kein Hinweis, sondern ein Rätsel. */
.z-carousel__direction-button:disabled {
	background: var(--_z-carousel-button-bg);
	cursor: default;
}

.z-carousel__direction-button:disabled svg {
	opacity: 0.6;
}

.z-carousel__direction-button:focus-visible {
	outline: 2px solid var(--z-ds-color-focus-100);
	outline-offset: 2px;
}

.z-carousel__direction-button--previous {
	margin-right: var(--z-ds-space-s);
}

.z-carousel__direction-icon {
	display: block;
	height: var(--_z-carousel-icon-size);
	margin: auto;
	width: var(--_z-carousel-icon-size);
}

/* Fortschritts-Zeile (Dots) links unter der Spur — dieselbe Grid-Zelle wie die
   Pfeile, nur an der anderen Kante. \`:not([hidden])\` ist die Weiche, über die
   das Element die Steuerung freigibt: Im Markup steht \`hidden\`, ohne
   JavaScript bleibt die Zeile also weg statt tot dazustehen. */
.z-carousel__tabpanel-control-wrapper:not([hidden]) {
	align-items: center;
	display: flex;
	grid-area: 2 / middle;
	max-width: min-content;
}

/* Wo eine Dot-Leiste läuft, verschwindet die native Scrollleiste — sonst stünde
   die Position doppelt da. */
.z-carousel:has(.z-carousel__tabpanel-control-wrapper) .z-carousel__scroll-container {
	overflow-x: scroll;
	-webkit-overflow-scrolling: touch;
	-ms-overflow-style: none;
	scrollbar-width: none;
}

.z-carousel:has(.z-carousel__tabpanel-control-wrapper) .z-carousel__scroll-container::-webkit-scrollbar {
	display: none;
}

/* Die Dots sind Radios: 16×16 Kasten mit 4px transparentem Rand, sichtbar ist
   über \`background-clip: content-box\` also ein 8er-Punkt. Der Abstand zwischen
   ihnen entsteht aus genau diesen Rändern (4+4 = 8) — deshalb hat die Leiste
   KEIN \`gap\`. (Figma zeichnet 6 px; die Auslieferung ergibt 8.) */
.z-carousel__dots-wrapper {
	border: none;
	display: flex;
	margin: 0;
	max-width: 7rem;
	min-width: 0;
	overflow: hidden;
	padding: 0;
	scroll-snap-type: x mandatory;
}

.z-carousel__dot {
	-webkit-appearance: none;
	appearance: none;
	background-clip: content-box;
	background-color: var(--z-ds-color-background-20);
	border: 0.25rem solid transparent;
	border-radius: 0.5rem;
	cursor: pointer;
	flex: 0 0 auto;
	height: 1rem;
	scroll-snap-align: start;
	transition:
		background-color 0.2s,
		border-width 0.2s linear,
		width 0.2s linear;
	width: 1rem;
}

.z-carousel__dot:checked {
	background-color: var(--z-ds-color-text-70);
	outline: none;
}

.z-carousel__dot:hover,
.z-carousel__dot:active,
.z-carousel__dot:focus-visible {
	background-color: var(--z-ds-color-text-40);
}

.z-carousel__dot:focus-visible,
.z-carousel__dot:checked:focus-visible {
	outline: 2px solid var(--z-ds-color-focus-100);
	outline-offset: -2px;
}

/* Viele Seiten, gleiche Leistenbreite: Der Punkt schrumpft über den Rand, nicht
   über die Kastengröße — so bleibt das Snap-Raster gleich. */
.z-carousel__dot[data-size='s'] {
	border-width: 0.3125rem;
}

.z-carousel__dot[data-size='xs'] {
	border-width: 0.40625rem;
}

/* ZWEITER 48em-Block — und der steht mit Absicht HIER, nach den Punkt-Regeln,
   genau wie im ausgelieferten CSS. Beide Deklarationen unten treten gegen
   gleichspezifische Basis-Regeln an (\`max-width: 7rem\`, \`width: 1rem\`); wer
   gewinnt, entscheidet die Reihenfolge. Stünden sie oben im ersten 48em-Block,
   überschriebe die Basis sie stillschweigend wieder — dieselbe Falle, in die
   das Original beim \`margin-bottom\` selbst getappt ist (siehe oben). Der
   Zusatz-\`.z-carousel\` vor der Punktleiste ist ebenfalls original: er hebt die
   Spezifität über die Basis-Regel. */
@media screen and (min-width: 48em) {
	/* Der aktive Punkt wird zur Kapsel — erst ab 48em und nur mehrspaltig. */
	.z-carousel:not(.z-carousel--single) .z-carousel__dot:checked {
		width: 1.5rem;
	}

	.z-carousel .z-carousel__dots-wrapper {
		max-width: 7.5rem;
	}
}

/* Play/Pause — die Steuerung, die die Auslieferung bei \`[autoplay]\` einhängt.
   Das Aussehen steht hier, damit der CSS-Weg vollständig bleibt; im Markup
   dieser Doku kommt der Knopf NICHT vor, weil \`<z-carousel>\` kein Autoplay
   mitbringt (Begründung im Kopf von carousel.ts) — und ein Knopf ohne Funktion
   ist schlechter als keiner. */
.z-carousel__playcontrol-button {
	background: var(--z-ds-color-background-10);
	border: none;
	border-radius: 50%;
	color: var(--z-ds-color-text-70);
	cursor: pointer;
	flex: 0 0 auto;
	height: var(--_z-carousel-button-size);
	margin-right: var(--z-ds-space-xs);
	width: var(--_z-carousel-button-size);
}

.z-carousel__playcontrol-button:hover,
.z-carousel__playcontrol-button:active,
.z-carousel__playcontrol-button:focus-visible {
	background: var(--z-ds-color-background-20);
}

.z-carousel__playcontrol-button:focus-visible {
	outline: 2px solid var(--z-ds-color-focus-100);
	outline-offset: 2px;
}

/* Die Auslieferung legt BEIDE Ikonen ein und blendet über eine Zustandsklasse
   genau eine ein. Diese Weiche fällt hier weg — ohne Autoplay gibt es keinen
   Lauf-Zustand, den sie abfragen könnte, und eine Regel auf eine Klasse, die
   nie gesetzt wird, wäre genau die Sorte No-op, die diese Datei gerade
   losgeworden ist. Wer den Knopf baut, legt eine Ikone ein. */
.z-carousel__playcontrol-icon {
	display: block;
	height: var(--_z-carousel-icon-size);
	margin: auto;
	width: var(--_z-carousel-icon-size);
}

/* ---- Varianten-Modifier ---- */
/* Alle vier spiegeln Attribute des Original-Elements (\`view-mode\`, \`variant\`,
   \`overlay-controls\`, \`autoplay\`) als Klasse: Der Doku-Renderer setzt keine
   benannten Attributwerte, und als Klasse funktionieren sie auch im reinen
   CSS-Weg. */

/* view-mode=single: eine Seite je Ansicht, ohne Gap und ohne Rand. */
.z-carousel--single {
	--_z-carousel-slide-width: 100%;
	--_z-carousel-slide-gap: 0;
}

.z-carousel--single .z-carousel__scroll-container {
	--_z-carousel-padding-inline: 0;
}

/* view-mode=continuous: freies Weiterscrollen ohne Einrasten. */
.z-carousel--continuous .z-carousel__scroll-container > * {
	scroll-snap-align: none;
}

/* overlay-controls: Die Pfeile liegen in den Rand-Spalten über der Spur. */
.z-carousel--overlay-controls .z-carousel__slide-control-wrapper {
	display: contents;
}

.z-carousel--overlay-controls .z-carousel__direction-button,
.z-carousel--overlay-controls .z-carousel__tabpanel-control-wrapper {
	z-index: 10;
}

.z-carousel--overlay-controls .z-carousel__direction-button {
	margin: auto;
	transition: opacity 100ms ease;
}

.z-carousel--overlay-controls .z-carousel__direction-button--previous {
	grid-area: 1 / left;
}

.z-carousel--overlay-controls .z-carousel__direction-button--next {
	grid-area: 1 / right;
}

/* variant=kiosk: feste schmale Slot-Breite (12.25rem = 196px). */
.z-carousel--kiosk {
	--_z-carousel-slide-width: 12.25rem;
}

/* variant=shop: breite Slots (20rem) und ein getönter Fader-Ton. */
.z-carousel--shop {
	--_z-carousel-slide-width: 20rem;
	--_z-carousel-button-gradient-color: var(--z-ds-color-background-10);
}

/* autoplay: Der aktive Punkt wird zur breiten Kapsel. Im Original läuft darin
   ein animierter Fortschritt (Abweichung b) — hier steht sein Endzustand. */
.z-carousel--autoplay .z-carousel__dots-wrapper {
	max-width: 7.875rem;
}

.z-carousel--autoplay .z-carousel__dot:checked {
	background-color: var(--z-ds-color-background-20);
	width: 1.875rem;
}

/* Figma-Prop \`Controls = false\`: Steuerung ganz weg. Produktion erreicht
   dasselbe über das \`hidden\`-Attribut, das ihr Element setzt — als Klasse ist
   es auch ohne JavaScript erreichbar. */
.z-carousel--no-controls .z-carousel__slide-control-wrapper,
.z-carousel--no-controls .z-carousel__tabpanel-control-wrapper:not([hidden]) {
	display: none;
}
`;
