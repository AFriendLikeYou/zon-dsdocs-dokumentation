{
	"name": "@zeit/components",
	"version": "0.0.0",
	"description": "ZEIT-Designsystem-Komponenten: unscoped Pattern-CSS plus der kanonische Spec (model.json) je Komponente — und, wo vorhanden, das Custom Element.",
	"type": "module",
	"license": "UNLICENSED",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"files": [
		"src"
	],
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*/index.ts",
		"./*.css": "./src/*.css",
		"./*/model.json": "./src/*/model.json",
		"./accordion/accordion": "./src/accordion/accordion.ts",
		"./carousel/carousel": "./src/carousel/carousel.ts",
		"./package.json": "./package.json"
	},
	"types": "./src/index.ts",
	"sideEffects": [
		"*.css",
		"./src/accordion/accordion.ts",
		"./src/carousel/carousel.ts"
	]
}
